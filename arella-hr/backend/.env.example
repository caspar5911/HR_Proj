# Environment variables (copy to .env)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arellahr
# REQUIRED, at least 32 random characters — the backend refuses to start with
# a missing, short, or well-known value. Generate your own; never commit one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-output-of-token_urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true

# Swagger UI + OpenAPI schema (GET /api/docs). Dev: true. For production
# deployments set false so the full API surface is not advertised.
# EXPOSE_API_DOCS=true

# CORS — comma-separated browser origins allowed to call the API.
# Add your GitHub Pages origin here when the frontend is served from it, e.g.
#   CORS_ORIGINS=http://localhost:5173,https://caspar5911.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed account (created automatically on first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123