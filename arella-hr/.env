# ── Arella HR — local environment overrides (Docker Compose) ─────────────────
# Read by docker-compose.yml. Defaults live in the compose file; this file
# adapts to THIS machine. Values here are dev-only — never reuse them outside
# local development.

# This machine's LLM stack (SGLang / open-webui) already holds :8000 and :3000,
# so the app publishes on different host ports:
BACKEND_PORT=8010
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=3010

# JWT signing key (dev only). The backend refuses to start with a missing,
# short, or well-known key. Generate a fresh one for any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=s620tOD46cIAmop0-753b7hyOQ4P7hJN8LFW437-TUKdFzgiSYoyudl_hjiHfDWS
